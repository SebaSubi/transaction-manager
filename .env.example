# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres — the POOLED connection string.
# The app rejects anything else: host must end in ".neon.tech", contain "-pooler.",
# and the URL must include sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Shared household password used on /login.
APP_PASSWORD=change-me

# Signs session cookies. At least 32 bytes. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Only for `pnpm db:seed:dev`: the exact hostname of the Neon BRANCH you want to fill
# with fake data. Leave empty unless you are seeding a dev branch.
DEV_SEED_ALLOWED_HOST=

# Do NOT set TZ here or in Vercel. The pnpm scripts set TZ=UTC, and Vercel reserves TZ.
